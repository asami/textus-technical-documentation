@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Hiragino Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam ranksep 15
skinparam nodesep 20
skinparam ArrowColor #506776
skinparam rectangleBorderColor #486477
skinparam rectangleBackgroundColor #F0F6F8
skinparam packageBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #F5F2E9
skinparam noteBackgroundColor #FFF8E9
skinparam dpi 170
rectangle "Typed contracts\nfrom models" as contract
rectangle "Existing components\nPublic Services / Operations" as existing
rectangle "Business-specific extensions\nCalculations / Integration" as extension
rectangle "Application assembly\nConnect through contracts" as app
rectangle "Textus / CNCF\nAuthorization / Commit\nFinalization / Observation" as runtime
contract -left-> existing : selection conditions
contract -right-> extension : implementation conditions
existing -down-> app : reuse
extension -down-> app : missing behavior
app -down-> runtime : shared execution paths
note bottom of runtime
Reuse business capabilities and execution management
end note

@enduml
