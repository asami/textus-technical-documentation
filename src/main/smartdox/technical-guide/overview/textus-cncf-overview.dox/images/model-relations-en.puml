@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Hiragino Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam ranksep 15
skinparam nodesep 20
skinparam ArrowColor #506776
skinparam rectangleBorderColor #486477
skinparam rectangleBackgroundColor #F0F6F8
skinparam packageBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #F5F2E9
skinparam noteBackgroundColor #FFF8E9
skinparam dpi 170
rectangle "Glossary / Literate models" as terms
rectangle "Use cases\nGoals, examples, expected results" as usecase
rectangle "Application\nWorkflow / Operation" as app
rectangle "Domain\nEntity / Value / Aggregate\nState machines / Rules" as domain
rectangle "View\nSemantic read results" as view
rectangle "Display / UI\nPresentation and actions" as ui
terms -right-> usecase : shared meaning
usecase -down-> app : realization and checks
app -left-> domain : business operations
domain -down-> view : reading
view -right-> ui : projection
ui -up-> app : public operations

@enduml
