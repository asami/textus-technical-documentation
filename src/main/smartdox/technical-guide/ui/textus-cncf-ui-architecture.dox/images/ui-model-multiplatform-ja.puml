@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Hiragino Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #506776
skinparam rectangleBorderColor #486477
skinparam rectangleBackgroundColor #F0F6F8
skinparam packageBorderColor #899DA9
skinparam packageBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #F5F2E9
skinparam sequenceParticipantBackgroundColor #F0F6F8
skinparam sequenceLifeLineBorderColor #899DA9
skinparam sequenceMessageAlign center
skinparam noteBackgroundColor #FFF8E9
skinparam noteBorderColor #C5B88B
skinparam dpi 170
skinparam ranksep 15
skinparam nodesep 20
rectangle "UIモデル ＋ Operation契約\n表示する情報・利用者の操作" as model
rectangle "Cozyによる生成（設計）\n設定・型付きバインディング" as generate
rectangle "Textus連動Flutterフレームワーク\nTFAF ＋ Textus Flutter Core" as runtime
rectangle "iPhone / Android\nスマートフォン・タブレット" as mobile
rectangle "Web / Desktop\nブラウザー・デスクトップアプリ" as desktop
model --> generate
generate --> runtime
runtime --> mobile : タッチ・画面領域
runtime --> desktop : マウス・キーボード
note right of runtime
 独自拡張は共通契約へ接続
 生成・設定と分けて管理
end note
@enduml
