@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Hiragino Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam ranksep 15
skinparam nodesep 20
skinparam ArrowColor #506776
skinparam rectangleBorderColor #486477
skinparam rectangleBackgroundColor #F0F6F8
skinparam packageBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #F5F2E9
skinparam noteBackgroundColor #FFF8E9
skinparam dpi 170
top to bottom direction
rectangle "業務モデル / CML\n概念・制約・操作" as model
rectangle "型付きの接点\nCozyによる具体化" as types
rectangle "純粋な業務計算\n明示した入力から結果" as calc
rectangle "Consequence\n成功値 / 構造化した失敗" as result
rectangle "操作のプログラム\nFree Monad + ConsequenceT" as program
rectangle "インタープリタ + UoW\n認可・作用・確定・資源管理" as runtime
model -down-> types : 意味を型へ
 types -down-> calc : 入出力の契約
calc -right-> result : 結果を返す
result -down-> program : 成功値を後続へ
program -left-> runtime : 解釈して実行
note bottom of runtime
同期呼出し・Jobから共通経路を利用
end note

@enduml
