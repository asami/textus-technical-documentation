@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Hiragino Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 8
skinparam ranksep 24
skinparam nodesep 22
skinparam ArrowColor #526476
skinparam ArrowThickness 1.5
skinparam rectangleBorderColor #66778B
skinparam rectangleBackgroundColor #EFF3F7
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #8D9AA8
skinparam databaseBackgroundColor #EFF3F7
skinparam noteBackgroundColor #FFF9E8
skinparam dpi 170
top to bottom direction
rectangle "CML models\nUpdate / read definitions / shared values" as model #EFF3F7
rectangle "Cozy\nTyped definitions / connections" as cozy #EFF3F7
rectangle "Supplementary code / Provider\nBusiness computation / external integration" as supplement #EFF3F7
rectangle "Component / CAR\nInstall definitions / implementation" as car #EFF3F7
rectangle "Update: Command / Aggregate\nUoW / authoritative store" as update #EFF3F7
rectangle "Read: Query / View\nDisplay" as read #EFF3F7
model -down-> cozy
cozy -down-> car
supplement -right-> car : Types / contracts
car -[#197A58]-> update : Register / run updates
car -[#2768A6]-> read : Register / run reads
update -[#9064A5,dashed]-> read : Committed results / selected projection
@enduml
