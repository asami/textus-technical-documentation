@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Hiragino Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 8
skinparam ranksep 24
skinparam nodesep 22
skinparam ArrowColor #526476
skinparam ArrowThickness 1.5
skinparam rectangleBorderColor #66778B
skinparam rectangleBackgroundColor #EFF3F7
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #8D9AA8
skinparam databaseBackgroundColor #EFF3F7
skinparam noteBackgroundColor #FFF9E8
skinparam dpi 170
top to bottom direction
rectangle "CMLのモデル\n更新定義 / 参照定義 / 共通の値" as model #EFF3F7
rectangle "Cozy\n型・定義・接続の生成" as cozy #EFF3F7
rectangle "補完処理・Provider\n業務計算・外部接続" as supplement #EFF3F7
rectangle "Component / CAR\n定義と実装の導入" as car #EFF3F7
rectangle "更新系: Command / Aggregate\nUoW / 正本" as update #EFF3F7
rectangle "参照系: Query / View\nDisplay" as read #EFF3F7
model -down-> cozy
cozy -down-> car
supplement -right-> car : 型と契約
car -[#197A58]-> update : 登録・更新実行
car -[#2768A6]-> read : 登録・参照実行
update -[#9064A5,dashed]-> read : 確定結果・選択した投影
@enduml
