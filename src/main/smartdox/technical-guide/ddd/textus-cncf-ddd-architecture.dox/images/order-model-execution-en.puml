@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Hiragino Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 8
skinparam ranksep 24
skinparam nodesep 22
skinparam ArrowColor #526476
skinparam ArrowThickness 1.5
skinparam rectangleBorderColor #66778B
skinparam rectangleBackgroundColor #EFF3F7
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #8D9AA8
skinparam databaseBackgroundColor #EFF3F7
skinparam noteBackgroundColor #FFF9E8
skinparam dpi 170
skinparam sequenceMessageAlign center
actor "User / UI" as user
participant "Command\nOperation" as op
participant "Order\nAggregate" as agg
participant "UoW /\nDataStore" as store
participant "Domain\nEvent" as event
participant "Query\nOperation" as query
participant "View /\nDisplay" as view
group Update path [CQRS]
user -[#197A58]> op : Confirm order
op -[#197A58]> agg : Check state, rules, amount
agg --[#197A58]> op : Proposed update
op -[#197A58]> store : Conditional commit
store --[#197A58]> op : Commit outcome
op --[#197A58]> user : Update outcome
end
op -[#9064A5]> event : Committed fact
event -[#9064A5]> view : Selected projection path
group Read path [CQRS]
user -[#2768A6]> query : Read order
query -[#2768A6]> view : Authorization / freshness
view --[#2768A6]> query : Read result: status / amount
query --[#2768A6]> user : Presentation result
end
note over agg, view
Value Objects such as Amount occur on both paths.
Commit and projection/delivery completion are distinct.
end note
@enduml
