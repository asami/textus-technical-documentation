@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Hiragino Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #506776
skinparam rectangleBorderColor #486477
skinparam rectangleBackgroundColor #F0F6F8
skinparam packageBorderColor #899DA9
skinparam packageBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #F5F2E9
skinparam sequenceParticipantBackgroundColor #F0F6F8
skinparam sequenceLifeLineBorderColor #899DA9
skinparam sequenceMessageAlign center
skinparam noteBackgroundColor #FFF8E9
skinparam noteBorderColor #C5B88B
skinparam dpi 170
skinparam ranksep 15
skinparam nodesep 20
rectangle "UI tier\nInteraction / result and progress" as ui
rectangle "Application tier\nAdmission / use-case coordination\nShort-lived execution / Cloud Function" as app
rectangle "Domain tier\nPublic Operations / rules / UoW\nLong-lived Subsystem / Working Set" as domain
database "DataStore\nDurable state" as store
ui --> app : Request
app --> domain : Public operation
domain --> store : Check / commit
domain ..> app : Capacity / admission result
note right of app
 Scale execution together
 with downstream capacity.
end note
@enduml
