@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Hiragino Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #506776
skinparam rectangleBorderColor #486477
skinparam rectangleBackgroundColor #F0F6F8
skinparam packageBorderColor #899DA9
skinparam packageBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #F5F2E9
skinparam sequenceParticipantBackgroundColor #F0F6F8
skinparam sequenceLifeLineBorderColor #899DA9
skinparam sequenceMessageAlign center
skinparam noteBackgroundColor #FFF8E9
skinparam noteBorderColor #C5B88B
skinparam dpi 170
skinparam ranksep 15
skinparam nodesep 20
rectangle "Command" as cmd
rectangle "Aggregate／状態機械\n業務規則" as rules
rectangle "UoW\n競合検査・確定" as uow
database "Entityの永続状態" as store
rectangle "Working Set／View\nメモリ・参照用投影" as view
rectangle "Query" as query
cmd -right-> rules
rules -right-> uow
uow -down-> store
store -left-> view : 再構築
uow ..> view : 確定後の更新／無効化
query -down-> view : 参照
note bottom of store
 非同期反映では鮮度と再参照条件を定める
 メモリ常駐は永続性の代わりではない
end note
@enduml
