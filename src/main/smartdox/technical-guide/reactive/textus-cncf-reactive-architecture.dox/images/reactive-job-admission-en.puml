@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Hiragino Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #506776
skinparam rectangleBorderColor #486477
skinparam rectangleBackgroundColor #F0F6F8
skinparam packageBorderColor #899DA9
skinparam packageBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #F5F2E9
skinparam sequenceParticipantBackgroundColor #F0F6F8
skinparam sequenceLifeLineBorderColor #899DA9
skinparam sequenceMessageAlign center
skinparam noteBackgroundColor #FFF8E9
skinparam noteBorderColor #C5B88B
skinparam dpi 170
skinparam ranksep 15
skinparam nodesep 20
rectangle "Request" as request
rectangle "Admission decision\nCapacity / authority / input" as admit
rectangle "Reject / advise waiting" as reject
rectangle "Accepted Job\nReturn ID and status" as job
rectangle "Bounded queue / execution slots" as queue
rectangle "Task execution → UoW commit / abort" as task
rectangle "Job outcome / execution records" as result
request --> admit
admit --> reject : Not admitted
admit --> job : Admitted
job --> queue
queue --> task
task --> result
queue ..> admit : Queue size / saturation
note right of task
 A whole Job need not be
 a single transaction.
end note
@enduml
